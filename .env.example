# Database
DATABASE_URL=postgres://savvy_app:savvy_app@localhost:5432/savvy        # app (RLS-enforced, non-superuser)
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/savvy    # migrations/seed (superuser)

# App
APP_BASE_URL=http://localhost:3000

# Auth (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# AI gateway (LiteLLM)
LITELLM_BASE_URL=
LITELLM_API_KEY=

# Telephony (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_FROM=                     # outbound SMS sender (E.164), used by lead.intake
# Master key for sealing per-tenant integration credentials (BYO telephony).
# Base64 encoding of exactly 32 random bytes. Generate: openssl rand -base64 32
INTEGRATION_SECRET_KEY=

# Testing only (do NOT set in prod) — Playwright e2e bypasses Clerk
TEST_MODE=
TEST_TENANT_ID=

# Payments (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe (Connect Standard) — Phase 5A
STRIPE_CONNECT_CLIENT_ID=

# Cloudflare R2 (document/photo storage) — Phase 6A
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=savvy-documents

# Integrations (Nango)
NANGO_SECRET_KEY=
NANGO_HOST=https://api.nango.dev
NANGO_GCAL_INTEGRATION_ID=google-calendar
# QuickBooks Online (via Nango) — Phase 5B
NANGO_QBO_INTEGRATION_ID=quickbooks
# Per-tenant Gmail send (Nango google-mail). Each tenant OAuths their own Google
# account; mail sends from that account. gmail.send is a restricted scope — the
# Google OAuth app runs in "testing mode" for the pilot (add test users); real
# multi-tenant prod needs Google verification + CASA.
NANGO_GMAIL_INTEGRATION_ID=google-mail

# Measurement (Roofr) — Phase 7
ROOFR_API_KEY=
NANGO_ROOFR_INTEGRATION_ID=roofr

# E-sign (DocuSeal) — Savvy-mediated: one Savvy-owned instance, Savvy-level key/URL.
DOCUSEAL_API_KEY=
DOCUSEAL_BASE_URL=
# When set, the DocuSeal webhook enforces an HMAC-SHA256 signature (X-Docuseal-Signature).
# Leave unset in dev/test (verification is skipped so the fake-first e2e works).
DOCUSEAL_WEBHOOK_SECRET=
# Estimate-signing template (Phase 7).
DOCUSEAL_TEMPLATE_ID=
# Closeout-signing standard templates (Phase 6B); per-tenant override via settings.esign.
DOCUSEAL_TEMPLATE_LIEN_WAIVER=
DOCUSEAL_TEMPLATE_CERT=
# Change-order signing template (Phase 6C).
DOCUSEAL_TEMPLATE_CHANGE_ORDER=

# Resend (transactional email — Phase 3 comms)
RESEND_API_KEY=
EMAIL_FROM="Savvy <noreply@example.com>"
# Signs email unsubscribe tokens
UNSUBSCRIBE_SECRET=dev-unsubscribe-secret

# Phase 6D — crew + CompanyCam
CREW_SESSION_SECRET=
NANGO_COMPANYCAM_INTEGRATION_ID=companycam
COMPANYCAM_API_KEY=
COMPANYCAM_WEBHOOK_SECRET=

# Observability
# Sentry: absence of SENTRY_DSN disables server/edge error tracking entirely (dev/e2e/TEST_MODE unaffected).
SENTRY_DSN=
# Public (browser) DSN — required for client-side error capture; usually the same project DSN.
NEXT_PUBLIC_SENTRY_DSN=
# Optional / future: enables source-map upload at build time (deferred — not required).
SENTRY_AUTH_TOKEN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Rate limiting (Upstash Redis REST). Absence of BOTH disables throttling (fail-open).
# Required in prod for /api/leads (10/60s) and crew PIN login (5/60s) limits to be active.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Clerk auth & provisioning (Phase: production readiness)
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/select-org

# ── Telephony SMS provider (RingCentral) ─────────────────────────────
# Set to "ringcentral" to route SMS through RingCentral (voice stays Twilio). Unset = Twilio.
TELEPHONY_SMS_PROVIDER=
RINGCENTRAL_SERVER_URL=https://platform.ringcentral.com
RINGCENTRAL_CLIENT_ID=
RINGCENTRAL_CLIENT_SECRET=
RINGCENTRAL_JWT=
RINGCENTRAL_FROM_NUMBER=
# REQUIRED in prod when TELEPHONY_SMS_PROVIDER=ringcentral: the inbound webhook fails
# CLOSED in production if this is unset. RC echoes it as the Verification-Token header.
RINGCENTRAL_WEBHOOK_TOKEN=

# ── Lead enrichment ──────────────────────────────────────────────────
# Google Places (browser key, restricted to Places + your referrers) — address autocomplete
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# StormProof backend — lead enrichment (year built via county assessor + storm history).
# Unset = the fake gateway is used (dev/test). AZ counties only for year built.
STORMPROOF_API_BASE=
STORMPROOF_API_KEY=

# Server-side Google key with Distance Matrix API enabled (NOT the NEXT_PUBLIC browser key).
# Unset => drive-time falls back to straight-line distance (fail-open).
GOOGLE_MAPS_SERVER_KEY=

# ── Phase D — AI voice agent (Vapi) ────────────────────────────────────
# Unset VAPI_API_KEY => the voice gateway is the fake: outbound calls no-op and
# the /api/voice/vapi webhook stays inert but deployable (fail-open).
VAPI_API_KEY=
VAPI_ASSISTANT_ID=          # the ONE shared assistant; per-call assistantOverrides brand it per tenant
VAPI_PHONE_NUMBER_ID=       # Vapi phone-number id used as the outbound caller
# Shared secret echoed by Vapi as the x-vapi-secret header on every webhook POST.
# REQUIRED in prod (the webhook 401s without a matching header). Set the assistant's
# server URL to https://<app>/api/voice/vapi.
VAPI_WEBHOOK_SECRET=

# ── Weather reschedule (D1b) ────────────────────────────────────────────
# Set to "nws" to enable real NWS forecasts for crew appointment weather checks.
# Unset = fake gateway (all-clear; no appointments are flagged). Fail-open.
WEATHER_PROVIDER=

# ── Inbound supplier-invoice email webhook (cell 13a) ───────────────────
# Cloudflare Email Routing (or Resend Inbound) → Worker → POST /api/inbound/supplier-invoice.
INBOUND_EMAIL_SECRET=
INBOX_DOMAIN=inbox.getsavvy.com
