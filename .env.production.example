# .env.production.example — the full env manifest for a Vercel production deploy.
#
# Copy each key into Vercel → Project → Settings → Environment Variables (Production).
# This file documents WHAT to set and WHY; it contains NO real secrets (never commit those).
#
# Differences from .env.example (dev):
#   - TEST_MODE / TEST_TENANT_ID are INTENTIONALLY ABSENT. TEST_MODE bypasses Clerk
#     and forces a synthetic tenant — setting it in prod disables auth + tenant isolation.
#   - Every "dev-*" fallback secret MUST be replaced with a real generated secret.
#   - DATABASE_URL / DATABASE_ADMIN_URL point at Neon, not localhost Docker.
#   - AI runs Anthropic-direct (no LiteLLM router) — see the AI section.
#
# Generate secrets with:  openssl rand -base64 32

# ── Database (Neon) ──────────────────────────────────────────────────────────
# App connection: the NON-superuser savvy_app role (RLS enforced). Created by
# scripts/prod-bootstrap.sql. Use the Neon POOLED connection string (-pooler host).
DATABASE_URL=postgres://savvy_app:<password>@<project>-pooler.<region>.aws.neon.tech/savvy?sslmode=require
# Admin connection: the Neon database OWNER. Used ONLY by `pnpm db:migrate` (run
# manually from your machine, NOT at deploy time). NOT required as a Vercel env var —
# the running app (incl. /api/health) only uses DATABASE_URL above. Keep it in your
# local shell when migrating; setting it on Vercel is optional.
DATABASE_ADMIN_URL=postgres://<owner>:<password>@<project>.<region>.aws.neon.tech/savvy?sslmode=require

# ── App / URLs ───────────────────────────────────────────────────────────────
APP_BASE_URL=https://app.yourdomain.com

# ── Auth (Clerk) — production instance ───────────────────────────────────────
# Use pk_live_/sk_live_ keys from a Clerk PRODUCTION instance with Organizations ON.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
# REQUIRED in prod: the Clerk webhook (svix) fails CLOSED (401) when this is unset.
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/select-org

# ── Inngest (Cloud) ──────────────────────────────────────────────────────────
# From the Inngest Cloud app. Register the synced URL https://<domain>/api/inngest.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Do NOT set INNGEST_DEV in prod (that's the local dev-server flag).

# ── AI gateway — Anthropic-direct (no LiteLLM router) ────────────────────────
# The @savvy/ai gateway is env-aware: when LITELLM_BASE_URL contains api.anthropic.com
# it resolves capability tiers → real Claude model ids. Add a LiteLLM router later
# (point these at it, use logical names) if/when multi-provider routing is needed.
LITELLM_BASE_URL=https://api.anthropic.com/v1
LITELLM_API_KEY=sk-ant-...

# ── Telephony (Twilio) ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_FROM=

# ── Payments (Stripe) — Connect Standard ─────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_CLIENT_ID=ca_...

# ── File storage (Cloudflare R2) ─────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=savvy-documents

# ── Integrations (Nango) ─────────────────────────────────────────────────────
NANGO_SECRET_KEY=
NANGO_HOST=https://api.nango.dev
NANGO_GCAL_INTEGRATION_ID=google-calendar
NANGO_QBO_INTEGRATION_ID=quickbooks
NANGO_ROOFR_INTEGRATION_ID=roofr
NANGO_COMPANYCAM_INTEGRATION_ID=companycam

# ── Measurement (Roofr) ──────────────────────────────────────────────────────
ROOFR_API_KEY=

# ── E-sign (DocuSeal) — one Savvy-owned instance ─────────────────────────────
DOCUSEAL_API_KEY=
DOCUSEAL_BASE_URL=https://docuseal.yourdomain.com
# REQUIRED in prod: webhook enforces HMAC-SHA256 when set (leave unset only in dev).
DOCUSEAL_WEBHOOK_SECRET=
DOCUSEAL_TEMPLATE_ID=
DOCUSEAL_TEMPLATE_LIEN_WAIVER=
DOCUSEAL_TEMPLATE_CERT=
DOCUSEAL_TEMPLATE_CHANGE_ORDER=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Savvy <noreply@yourdomain.com>"
# REQUIRED in prod: signs unsubscribe tokens. Dev defaults to "dev-unsubscribe-secret";
# you MUST set a real generated value here or unsubscribe links are forgeable.
UNSUBSCRIBE_SECRET=

# ── Crew + CompanyCam ────────────────────────────────────────────────────────
# REQUIRED in prod: signs crew PIN session cookies. Generate a real secret.
CREW_SESSION_SECRET=
COMPANYCAM_API_KEY=
# REQUIRED in prod: webhook HMAC verification fails closed without it.
COMPANYCAM_WEBHOOK_SECRET=

# ── Observability (optional now; hardening sub-project wires these) ───────────
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── Telephony SMS provider (RingCentral) ─────────────────────────────
# Set to "ringcentral" to route SMS through RingCentral (voice stays Twilio). Unset = Twilio.
TELEPHONY_SMS_PROVIDER=
RINGCENTRAL_SERVER_URL=https://platform.ringcentral.com
RINGCENTRAL_CLIENT_ID=
RINGCENTRAL_CLIENT_SECRET=
RINGCENTRAL_JWT=
RINGCENTRAL_FROM_NUMBER=
# REQUIRED in prod when TELEPHONY_SMS_PROVIDER=ringcentral: the inbound webhook fails
# CLOSED in production if this is unset. RC echoes it as the Verification-Token header.
RINGCENTRAL_WEBHOOK_TOKEN=
